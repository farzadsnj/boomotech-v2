# Public origins. Keep indexing disabled until content and legal review are complete.
SITE_URL=https://boomotech.com.au
SITE_INDEXING_ENABLED=false

# PostgreSQL. Supply a private postgresql:// connection string in the real environment.
DATABASE_URL=

# Better Auth. Generate a new secret with at least 32 random bytes.
BETTER_AUTH_URL=https://boomotech.com.au
BETTER_AUTH_SECRET=

# Server-only Resend authentication email configuration.
RESEND_API_KEY=
AUTH_FROM_EMAIL="BoomoTech <noreply@send.boomotech.com.au>"
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=60

# Booking notification delivery.
BOOKING_NOTIFICATION_EMAIL=
BOOKING_FROM_EMAIL="BoomoTech <noreply@send.boomotech.com.au>"

# Optional shared booking limiter for a multi-instance deployment.
BOOKING_RATE_LIMIT_REST_URL=
BOOKING_RATE_LIMIT_REST_TOKEN=

# Enable only when Nginx overwrites forwarded client-address headers.
BOOKING_TRUST_PROXY=false

# Used only by pnpm admin:seed. Remove the temporary password after bootstrap.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_TEMP_PASSWORD=
