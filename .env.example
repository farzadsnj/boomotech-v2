# Replace with the approved public origin before launch, for example https://example.com
SITE_URL=http://localhost:3000

# Keep false until the owner approves the public domain, copy, services and policies.
SITE_INDEXING_ENABLED=false
BOOKING_NOTIFICATION_EMAIL=
BOOKING_FROM_EMAIL=
RESEND_API_KEY=

# Required in production: shared, expiring rate-limit storage with an Upstash-compatible REST API.
BOOKING_RATE_LIMIT_REST_URL=
BOOKING_RATE_LIMIT_REST_TOKEN=

# Enable only when the deployment proxy overwrites forwarding headers from clients.
BOOKING_TRUST_PROXY=false

# PostgreSQL-backed customer and administrator accounts.
DATABASE_URL=postgres://boomotech:boomotech@localhost:5433/boomotech

# Generate at least 32 random bytes; never reuse this example value in a real environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used only by `pnpm admin:seed`. Keep the real values in untracked .env.local,
# then remove ADMIN_TEMP_PASSWORD immediately after setup.
ADMIN_USERNAME=farzadsnj
ADMIN_EMAIL=
ADMIN_TEMP_PASSWORD=
