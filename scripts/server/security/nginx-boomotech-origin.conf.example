# Review against the active Cloudflare Tunnel ingress before use.
server {
    listen 127.0.0.1:80;
    listen [::1]:80;
    server_name boomotech.com.au www.boomotech.com.au;

    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header CF-Connecting-IP;

    # Compress text responses on the loopback origin hop. Cloudflare may negotiate
    # Brotli or newer compression separately for the visitor-facing connection.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
