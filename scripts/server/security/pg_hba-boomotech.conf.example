# Example policy fragments. Merge with the active pg_hba.conf only after
# identifying the application database and role. Order matters in pg_hba.conf.
local   all             postgres                                peer
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256

# Do not add 0.0.0.0/0, ::/0 or trust rules for application access.
